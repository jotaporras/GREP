{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PRISM: Train RPEARL + edges + EvalCallback",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}/src",
      "justMyCode": false,
      "env": {
        "WANDB_ENTITY": "alelab",
        "UNSLOTH_RETURN_LOGITS": "1"
      },
      "args": [
        "--name",
        "dev_e2_eval",
        "--architecture",
        "rpearl_llm",
        "--text_edge_list",
        "present",
        "--checkpoint_dir",
        "../outputs_dev",
        "--data",
        "../data/gen/spine_exp1/formatted.json",
        "--eval_data",
        "../data/eval/eval_1_multi_step.json",
        "--base_model",
        //"meta-llama/Llama-3.1-8B-Instruct",
        "meta-llama/Llama-3.2-3B-Instruct",
        "--bit4",
        "false",
        "--epochs",
        "2",
        "--debug",
        "false",
        "--warmup_steps",
        "5",
        "--per_device_train_batch_size",
        "2",
        "--gradient_accumulation_steps",
        "2",
        "--learning_rate",
        "2e-4",
        "--weight_decay",
        "1e-3",
        "--r",
        "16",
        "--lora_alpha",
        "16",
        "--lora_dropout",
        "0.2",
        "--d_model",
        "3072",
        "--pe_hidden_channels",
        "256",
        "--pe_num_layers",
        "5",
        "--num_samples",
        "40",
        "--dropout",
        "0.05",
        "--k",
        "3",
        "--use_layer_norm",
        "true",
        "--freeze_llm",
        "false",
        "--wandb_run_name",
        "dev_e1_rpearl_edges_eval",
        "--wandb_tag",
        "dev_e1_rpearl_eval",
        "--wandb_project",
        "GREP-PRISM"
      ]
    },
