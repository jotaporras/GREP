{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PRISM: Debug eval — e3 RPEARL on single e4 graph",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_checkpoint_on_graphs.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/SPINE/src",
        "CUDA_VISIBLE_DEVICES": "1"
      },
      "args": [
        // will output to outputs/e3_new_training_data/e3_rpearl_llm_llama-3.1-8b_r16_4bit_qmu8x2qu/eval_logs/cross_eval/debug_graph.json
        //ie checkpoint/cross_eval/debug_graph.json
        "--checkpoint", "outputs/e3_new_training_data/e3_rpearl_llm_llama-3.1-8b_r16_4bit_qmu8x2qu",
        "--graphs", "data/debug_graph.json",
        "--text-edge-list", "none"
      ]
    },
    {
      "name": "Generate Training Data (SPINE, single rollout)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/training_data_generation/generate_data_spine.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/SPINE/src"
      },
      "args": [
        // Full pipeline on ONE small skeleton graph (8 regions, 2 objects, 3 tasks).
        // Phase 1: gpt-5.1 with reasoning=high populates names/descriptions/tasks.
        // Phase 2: SPINE planner runs on each generated task.
        // Expected cost: ~$0.20-$0.40 for Phase 1 + Phase 2 planner calls.
        "--data-dir", "data/single_rollout_input",
        "--name", "data/gen/spine_single_rollout"
      ]
    },
    {
      "name": "Generate Training Data (SPINE)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/training_data_generation/generate_data_spine.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/SPINE/src"
      },
      "args": [
        "--data-dir", "data/base_graphs",
        "--name", "data/gen/spine_dev",
        "--n-samples", "1",
        "--n-tasks", "5",
        "--temperature", "0.31"
      ]
    },
    {
      "name": "PRISM: DEV: Fast Run (1% data, no wandb, ETA )",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        // "WANDB_MODE": "disabled",
        "UNSLOTH_RETURN_LOGITS": "1",
        "CUDA_VISIBLE_DEVICES": "1"
      },
      "args": [
        "--name",
        "fast_run",
        "--architecture",
        "rpearl_llm",
        "--text_edge_list",
        "present",
        "--checkpoint_dir",
        "outputs/dev",
        "--data",
        //"data/gen/spine_exp1/formatted.json",
        //"data/2026_04_10_new_training/zac_20260402_training_v1.json",
        "data/training_data_graphs_20260422/aggregate/training_data_20260422.json",
        "--eval_data",
        //"data/eval/eval_1_multi_step.json",
        "data/training_data_graphs_20260422/aggregate/graphs/data_gen_000.json",
        "--base_model",
        // "meta-llama/Llama-3.2-3B-Instruct",
        //"meta-llama/Llama-3.1-8B-Instruct",
        // "Qwen/Qwen2.5-0.5B-Instruct",
        "HuggingFaceTB/SmolLM2-135M-Instruct",
        "--per_device_train_batch_size",
        // "8",
        "1",
        "--bit4",
        "false",
        "--epochs",
        "1",
        "--max_steps",
        "3",
        "--debug",
        "false",
        "--dataset_proportion",
        "0.01",
        "--warmup_steps",
        "1",
        "--gradient_accumulation_steps",
        "2",
        "--learning_rate",
        "2e-4",
        "--weight_decay",
        "1e-3",
        "--r",
        "16",
        "--lora_alpha",
        "16",
        "--lora_dropout",
        "0.2",
        "--d_model",
        "3072",
        "--pe_hidden_channels",
        "256",
        "--pe_num_layers",
        "5",
        "--num_samples",
        "40",
        "--dropout",
        "0.05",
        "--k_pe",
        "3",
        "--use_layer_norm",
        "true",
        "--freeze_llm",
        "false",
        "--wandb_project",
        "GREP-PRISM",
        
        "--wandb_run_name",
        "fast_run",
        "--wandb_tag",
        "deleteme_dev_qwen",
        // For debugging
        "--dataset_num_proc",
        "1",
        "--dataloader_num_workers",
        "1"
      ]
    },
    {
      "name": "PRISM: Train LoRA (SPINE)",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",     
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        //"WANDB_MODE": "disabled",
        "WANDB_ENTITY": "alelab",
        "UNSLOTH_RETURN_LOGITS": "1"
      },
      "args": [
        "--name",
        "sft_spine",
        "--checkpoint_dir",
        "outputs/dev",
        "--data",
        "data/gen/spine_exp1/formatted.json",
        "--eval_data",
        "data/eval/eval_1_multi_step.json",
        "--base_model",
        //"meta-llama/Meta-Llama-3.2-3B-Instruct",
        "Qwen/Qwen2.5-0.5B-Instruct",
        "--bit4",
        "false",
        "--epochs",
        "5",
        "--debug",
        "--dataset_proportion",
        "0.1",
        "--pe_num_layers",
        "100",
        "--warmup_steps",
        "5",
        "--per_device_train_batch_size",
        "4",
        "--gradient_accumulation_steps",
        "2",
        "--learning_rate",
        "2e-4",
        "--weight_decay",
        "1e-3",
        "--r",
        "32",
        "--lora_alpha",
        "16",
        "--lora_dropout",
        "0.2",
        "--wandb_run_name",
        "spine_lora",
        "--wandb_tag",
        "spine",
        "--wandb_project",
        "GREP-PRISM"
      ]
    },
    {
      "name": "PRISM: Train LoRA (SayCan)",
      "type": "debugpy",
      "request": "launch",
      // "module": "prism.training.train",
       "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "WANDB_ENTITY": "alelab",
        "UNSLOTH_RETURN_LOGITS": "1"
      },
      "args": [
        "--name",
        "sft_saycan",
        "--checkpoint_dir",
        "outputs/dev",
        "--data",
        "data/gen/saycan/formatted.json",
        "--eval_data",
        "data/eval/eval_1_multi_step.json",
        "--base_model",
        "unsloth/Llama-3.2-1B-bnb-4bit",
        "--bit4",
        "true",
        "--epochs",
        "5",
        "--warmup_steps",
        "5",
        "--per_device_train_batch_size",
        "4",
        "--gradient_accumulation_steps",
        "2",
        "--learning_rate",
        "1e-4",
        "--weight_decay",
        "1e-3",
        "--r",
        "32",
        "--lora_alpha",
        "16",
        "--lora_dropout",
        "0.2",
        "--wandb_run_name",
        "saycan_lora",
        "--wandb_tag",
        "saycan",
        "--wandb_project",
        "GREP-PRISM"
      ]
    },
    {
      "name": "PRISM: Train LLM no-edge-list (ablation)",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "WANDB_MODE": "disabled",
        "UNSLOTH_RETURN_LOGITS": "1"
      },
      "args": [
        "--name",
        "sft_spine_no_edges",
        "--architecture",
        "rpearl_llm",
        "--text_edge_list",
        "present",
        //"none",
        "--checkpoint_dir",
        "outputs/dev",
        "--data",
        "data/gen/spine_exp1/formatted.json",
        "--base_model",
        //"Qwen/Qwen2.5-0.5B-Instruct",
        "meta-llama/Llama-3.2-3B-Instruct",
        "--bit4",
        "false",
        "--epochs",
        "2",
        "--debug",
        "true",
        "--dataset_proportion",
        "0.1",
        "--warmup_steps",
        "5",
        "--per_device_train_batch_size",
        "4",
        "--gradient_accumulation_steps",
        "2",
        "--learning_rate",
        "2e-4",
        "--weight_decay",
        "1e-3",
        "--r",
        "16",
        "--lora_alpha",
        "16",
        "--lora_dropout",
        "0.2",
        "--wandb_run_name",
        "spine_no_edges",
        "--wandb_tag",
        "ablation_edge_list",
        "--wandb_project",
        "GREP-PRISM",
        "--report_to",
        "none"
      ]
    },
    
    {
      "name": "PRISM: Evaluate Checkpoint",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        // LLM Checkpoint 
        //"outputs/e2_rpearl_improvements/e2_llm_llama-3.1-8b_r16_4bit_1x0xqg4q",
        // R-PEARL Checkpoint
        "outputs/e2_rpearl_improvements/e2_rpearl_llm_llama-3.1-8b_r16_4bit_0wkv3lic",
        "--four-bit",
        "--eval-data",
        "data/eval/eval_1_multi_step.json",
        "--output",
        "results.json"
      ]
    },
    {
      "name": "PRISM: e4 RPEARL (newdata2, no_edges)",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "UNSLOTH_RETURN_LOGITS": "1",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "args": [
        "experiments/e4_new_training_data_2/e4_rpearl_llm_no_edges.yaml"
      ]
    },
    {
      "name": "PRISM: e4 RPEARL+GT (newdata2, no_edges)",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "UNSLOTH_RETURN_LOGITS": "1",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "args": [
        "experiments/e4_new_training_data_2/e4_rpearl_llm_gt_no_edges.yaml"
      ]
    },
    {
      "name": "PRISM: e4 LLM text baseline (newdata2)",
      "type": "debugpy",
      "request": "launch",
      "module": "prism.training.train_v2",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "UNSLOTH_RETURN_LOGITS": "1",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "args": [
        "experiments/e4_new_training_data_2/e4_llm.yaml"
      ]
    },
    
  ]
}
